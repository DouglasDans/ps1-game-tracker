[daemon]
poll_interval_s = 3
port = 8080
db_path = "~/.local/share/ps1-tracker/tracker.db"

[watchers]
# Verificar com `ps aux | grep -i duck` no Pi — nome do processo pode variar
process_names = ["duckstation-qt", "duckstation", "DuckStation", "PPSSPPSDL", "ppsspp"]
rom_extensions = [".cue", ".chd", ".bin", ".iso", ".cso", ".pbp"]
# Apenas arquivos dentro destes diretórios são tratados como ROMs (whitelist)
rom_dirs = ["/mnt/usb-flash"]

# PS2 via OPL/Samba — paths no servidor onde as ISOs estão acessíveis
# Requer: douglasdans ALL=(ALL) NOPASSWD: /usr/bin/smbstatus
samba_rom_dirs = []  # ex: ["/srv/samba/ps2roms"]
# Polls consecutivos sem lock antes de fechar sessão samba (OPL pode liberar o lock brevemente durante boot)
samba_debounce_polls = 3
# Janela (segundos) para retomar a mesma sessão em vez de abrir uma nova, se o mesmo
# jogo+fonte reaparecer logo após o fechamento (evita sessão fantasma partida ao meio)
session_resume_grace_s = 35

# RetroArch — diretório de playlists para importar sessões via .lrtl
retroarch_playlist_dirs = []  # ex: ["~/.config/retroarch/playlists"]

[igdb]
# Twitch developer app — https://dev.twitch.tv/console/apps
# client_credentials grant: não requer login de usuário
client_id     = ""
client_secret = ""

[retroachievements]
enabled = false
username = ""
api_key = ""

[notion]
enabled = false
token = ""
database_id = ""
